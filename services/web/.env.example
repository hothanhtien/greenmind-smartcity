# Copy to .env.local and fill in. Never commit .env.local.
# Backend API base URL (defaults to production when unset)
NEXT_PUBLIC_API_URL=http://localhost:4000
# AI service base URL (defaults to production when unset)
NEXT_PUBLIC_AI_URL=http://localhost:8000
# Minimum AI pollution score for suggesting a campaign (private business rule; value is bundled into the client)
NEXT_PUBLIC_CAMPAIGN_POLLUTION_THRESHOLD=
