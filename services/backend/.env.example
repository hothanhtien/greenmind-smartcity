#!/bin/sh
# Copy to .env and fill in. Never commit .env.
export PORT="4000"
export HOST="localhost"
export DEPLOY_ENV="development" # development | staging | production | test

export DB_HOST="localhost"
export DB_NAME="green_mind_db"
export DB_USERNAME="postgres"
export DB_PASSWORD=""
export DB_PORT="5432"
export DB_URL=""

export JWT_SECRET_KEY="" # long random string
export JWT_ALGORITHM="HS256"
export JWT_EXPIRE="7d"

export ALLOWED_DOMAINS="" # Comma-separated list of allowed domains, e.g., "example.com,example.org"
export GLOBAL_DOMAIN=""

export REDIS_HOST="localhost"
export REDIS_PORT="6379"
export REDIS_PASSWORD=""
export REDIS_DB="0"

export R2_ACCOUNT_ID=""
export R2_ACCESS_KEY_ID=""
export R2_SECRET_ACCESS_KEY=""
export R2_BUCKET=""
export R2_PUBLIC_URL=""

export DOMAIN_NAME=""
export AI_SERVICE_URL="" # Base URL of the AI service, e.g. http://localhost:8000 (defaults to production)

export GREENMIND_CORE_DIR="" # Private core dir (behavior params, business rules); placeholder core.example/ is used when empty
