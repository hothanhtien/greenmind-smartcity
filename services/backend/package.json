{
  "name": "green_mindmap_be",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "migration:create": "ts-node -r tsconfig-paths/register ./src/runner/migration_create.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./src/runner/migration_generate.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/database.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/infrastructure/database.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/database.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "db:drop": "yarn typeorm schema:drop -d src/infrastructure/database.ts",
    "db:run": "yarn typeorm migration:run -d src/infrastructure/database.ts",
    "db:generate": "yarn typeorm migration:generate -d src/infrastructure/database.ts",
    "jest": "jest",
    "test": "jest",
    "test:socket": "node scratch/test_socket.js",
    "test:socket:multi": "node scratch/test_socket_multi.js",
    "test:socket:interactive": "node scratch/test_socket_interactive.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@aws-sdk/lib-storage": "^3.1013.0",
    "@types/axios": "^0.14.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/form-data": "^2.2.1",
    "@types/socket.io": "^3.0.2",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "decomment": "^0.9.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "form-data": "^4.0.5",
    "ioredis": "^5.6.1",
    "jest": "^30.1.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "redis": "^5.5.6",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.1",
    "supertest": "^7.1.4",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.4",
    "typeorm": "^0.3.25",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.10",
    "openapi-types": "^12.1.3",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
